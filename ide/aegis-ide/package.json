{
  "name": "aegis-ide",
  "version": "0.1.0",
  "description": "Aegis IDE extension: security findings panel, audit commands, and the bridge to the Aegis compiler",
  "license": "MIT",
  "keywords": [
    "theia-extension"
  ],
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/workspace": "1.75.0",
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "watch": "tsc -b -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/aegis-frontend-module",
      "backend": "lib/node/aegis-backend-module"
    }
  ],
  "main": "lib/common/index",
  "types": "lib/common/index",
  "files": [
    "lib",
    "src"
  ]
}
