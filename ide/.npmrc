# Dependency install scripts are not run.
#
# Two reasons, either sufficient on its own:
#
# 1. Portability. Theia depends on `drivelist`, whose install script compiles
#    C++ and publishes no prebuilt Windows binary. On a machine without the
#    Visual Studio C++ workload that script fails, and npm aborts the whole
#    install. With scripts off, install succeeds everywhere, and the build
#    substitutes a pure-JS drivelist where the native one is absent
#    (browser-app/esbuild.mjs). Every other native module Prahari needs ships a
#    prebuilt binary inside its package.
#
# 2. Supply chain. An install script is arbitrary code from every transitive
#    dependency, run at install time with the developer's permissions. Not
#    running them by default is the conservative posture.
#
# This does not affect `npm run build` or `npm start`: npm still runs a script
# that is invoked explicitly.
ignore-scripts=true
