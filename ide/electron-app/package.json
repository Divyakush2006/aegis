{
  "name": "electron-app",
  "version": "0.1.0",
  "private": true,
  "description": "The Prahari IDE desktop application",
  "license": "MIT",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/bulk-edit": "1.75.0",
    "@theia/callhierarchy": "1.75.0",
    "@theia/console": "1.75.0",
    "@theia/core": "1.75.0",
    "@theia/debug": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/editor-preview": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/external-terminal": "1.75.0",
    "@theia/file-search": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/getting-started": "1.75.0",
    "@theia/keymaps": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/mini-browser": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/notebook": "1.75.0",
    "@theia/outline-view": "1.75.0",
    "@theia/output": "1.75.0",
    "@theia/plugin-ext": "1.75.0",
    "@theia/plugin-ext-vscode": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/property-view": "1.75.0",
    "@theia/scm": "1.75.0",
    "@theia/search-in-workspace": "1.75.0",
    "@theia/secondary-window": "1.75.0",
    "@theia/task": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/test": "1.75.0",
    "@theia/timeline": "1.75.0",
    "@theia/typehierarchy": "1.75.0",
    "@theia/userstorage": "1.75.0",
    "@theia/variable-resolver": "1.75.0",
    "@theia/vsx-registry": "1.75.0",
    "@theia/workspace": "1.75.0",
    "prahari-ide": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "clean": "theia clean",
    "build": "node build.js --mode development",
    "start": "theia start --plugins=local-dir:../plugins",
    "watch": "node build.js --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Prahari IDE",
        "preferences": {
          "files.enableTrash": false,
          "editor.renderWhitespace": "selection",
          "window.titleBarStyle": "custom"
        },
        "electron": {
          "showWindowEarly": true,
          "uriScheme": "prahari",
          "appUserModelId": "org.prahari.ide",
          "windowOptions": {
            "icon": "resources/prahari.ico"
          }
        }
      }
    },
    "backend": {
      "config": {
        "singleInstance": true
      }
    }
  }
}
